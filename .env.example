# Claude / Agent SDK
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Only needed if the Claude Code CLI isn't on PATH:
# CLAUDE_CODE_CLI_PATH=/usr/local/bin/claude

# Document locations
DOCS_FOLDER=./samples
OUTPUT_FOLDER=./output

# Microsoft Graph: send the compliance report, poll for approve/reject replies
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
EMAIL_TO=

# Salesforce: client<->advisor notes/comments per account
SF_DOMAIN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Only if not using pure client-credentials:
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# Only if your org's Account object uses a different field name:
# SF_ACCOUNT_NUMBER_FIELD=Account_Number__c

# Compliance ledger / watcher
LEDGER_PATH=./output/compliance_ledger.sqlite3
COMPLIANCE_POLL_SECONDS=60
